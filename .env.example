# Epoch Hub Environment Configuration

# Session Auth Secret
AUTH_SECRET=epoch_hub_super_secret_jwt_key_2026_production_grade_32bytes_min

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SQLite Database File Path (Default: ./data/epoch_hub.db)
DATABASE_PATH=./data/epoch_hub.db

# Storage Directory for Uploaded Task Files
STORAGE_DIR=./data/uploads

# Mock OTP in Development (Default: 123456)
DEV_OTP=123456

# (Optional) Supabase Secret Configuration (Server-Only)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
